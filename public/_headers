# Cloudflare Pages custom headers
# Security headers for all pages

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

# Cache static assets (JavaScript and CSS bundles with hashed filenames)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache all other assets folder content
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

# Cache images with longer TTL
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Cache manifest and other metadata (shorter TTL)
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

# Don't cache HTML for fresh content (SPA needs fresh index.html)
# IMPORTANT: Root path / serves index.html but doesn't match /*.html,
# so it needs its own rule to prevent CDN caching stale HTML with old
# JS chunk hashes after deployments.
/
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Language-prefixed root paths also serve index.html via SPA fallback
/en
  Cache-Control: no-cache, no-store, must-revalidate
/sq
  Cache-Control: no-cache, no-store, must-revalidate
/sr
  Cache-Control: no-cache, no-store, must-revalidate
/mk
  Cache-Control: no-cache, no-store, must-revalidate
/bs
  Cache-Control: no-cache, no-store, must-revalidate
/hr
  Cache-Control: no-cache, no-store, must-revalidate
/bg
  Cache-Control: no-cache, no-store, must-revalidate
/ro
  Cache-Control: no-cache, no-store, must-revalidate
/el
  Cache-Control: no-cache, no-store, must-revalidate
/me
  Cache-Control: no-cache, no-store, must-revalidate
