{
  "name": "BalkanEstateAI",
  "short_name": "BalkanEstateAI",
  "description": "Find your dream property in the Balkans with AI. Browse houses, apartments, and villas for sale and rent across Kosovo, Albania, North Macedonia, Serbia, Bosnia and Herzegovina, Croatia, Montenegro, Greece, Bulgaria, and Romania.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#ffffff",
  "theme_color": "#0252CD",
  "orientation": "any",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["real estate", "property", "housing", "business"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "icons": [
    {
      "src": "/icons/Logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/Logo.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Properties",
      "short_name": "Search",
      "description": "Search for properties in the Balkans",
      "url": "/search",
      "icons": [{ "src": "/icons/search-icon.svg", "sizes": "96x96" }]
    },
    {
      "name": "Find Agents",
      "short_name": "Agents",
      "description": "Find verified real estate agents",
      "url": "/agents",
      "icons": [{ "src": "/icons/agents-icon.svg", "sizes": "96x96" }]
    },
    {
      "name": "Saved Properties",
      "short_name": "Saved",
      "description": "View your saved properties",
      "url": "/saved-properties",
      "icons": [{ "src": "/icons/saved-icon.svg", "sizes": "96x96" }]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "Access your account dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/dashboard-icon.svg", "sizes": "96x96" }]
    }
  ],
  "related_applications": [],
  "handle_links": "preferred"
}
