# =============================================================================
# Frontend Environment Variables - PRODUCTION
# =============================================================================

# Environment identifier
VITE_APP_ENV=production

# API Configuration - Point to production backend
VITE_API_URL=https://api.balkanestateai.com
VITE_WS_URL=wss://api.balkanestateai.com

# Frontend URL
VITE_APP_URL=https://balkanestateai.com

# Feature Flags - Disable debugging in production
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEVTOOLS=false

# Analytics - Production analytics IDs
VITE_GA_ID=G-XXXXXXXXXX
VITE_FB_PIXEL_ID=

# Stripe - Use LIVE publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key

# AI Services
GEMINI_API_KEY=your_api_key

# Sentry
VITE_SENTRY_DSN=
