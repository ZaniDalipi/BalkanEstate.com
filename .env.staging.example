# =============================================================================
# Frontend Environment Variables - STAGING
# =============================================================================

# Environment identifier
VITE_APP_ENV=staging

# API Configuration - Point to staging backend
VITE_API_URL=https://api-staging.balkanestate.com
VITE_WS_URL=wss://api-staging.balkanestate.com

# Frontend URL
VITE_APP_URL=https://staging.balkanestate.com

# Feature Flags - Enable debugging in staging
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEVTOOLS=true

# Analytics - Use staging/test analytics
VITE_GA_ID=
VITE_FB_PIXEL_ID=

# Stripe - Use TEST publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# AI Services
GEMINI_API_KEY=your_api_key

# Sentry
VITE_SENTRY_DSN=
