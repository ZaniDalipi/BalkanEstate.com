curity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"rentPeriod\":\"monthly\",\"rentalHistory\":[],\"tenantRequirements\":[]},{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slotDurationMinutes\":30},\"rentPeriod\":\"monthly\",\"tenantRequirements\":[],\"_id\":\"69457f2a9dfb51a9b1ebe4c4\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"createdAsRole\":\"private_seller\",\"title\":\"Example\",\"status\":\"active\",\"price\":159449,\"address\":\"Jistinian, Pogradec, Bashkia Pogradec, Qarku i Korçës, Shqipëria Jugore, 7301, Shqipëria\",\"city\":\"Pogradec\",\"country\":\"Albania\",\"beds\":1,\"baths\":1,\"livingRooms\":1,\"sqft\":180,\"yearBuilt\":2015,\"parking\":1,\"description\":\"Discover this captivating house, blending modern design with a warm, inviting atmosphere. This property boasts an expansive living area, perfect for both tranquil relaxation and lively entertaining. The thoughtful design emphasizes natural light and a seamless flow, offering a truly unique living experience in the heart of the Balkans. Key Features:  Spacious open-plan living area with vaulted ceilings  Abundant natural light through multiple windows  Contemporary interior design with a minimalist aesthetic  Integrated wall-mounted entertainment area  Elegant plantation shutters for light control and privacy Materials & Construction:  Laminate wood flooring throughout the main living space  Crisp white painted shiplap paneling on walls and ceiling  Exposed white-painted structural beams adding architectural interest  Custom wood paneling accent wall for television  Modern ceiling fan for comfort\",\"specialFeatures\":[\"ceiling fan\",\"Spacious open-plan living area\",\"Vaulted ceilings with exposed beams\",\"Modern aesthetic and clean lines\",\"Large windows with plantation shutters\",\"Integrated media wall\",\"Bright and airy interior\"],\"materials\":[\"Wood laminate flooring\",\"White painted shiplap walls\",\"White painted timber ceiling\",\"White painted structural beams\",\"Wood accent wall\",\"Fabric sofa\"],\"tourUrl\":\"\",\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766162199/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/ifnn0c91jmyldujzosne.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766162199/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/ifnn0c91jmyldujzosne.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/ifnn0c91jmyldujzosne\",\"tag\":\"living_room\",\"_id\":\"69457f2a9dfb51a9b1ebe4c5\"}],\"lat\":40.8988895,\"lng\":20.6555298,\"propertyType\":\"house\",\"totalFloors\":1,\"views\":11,\"saves\":0,\"inquiries\":1,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"lastRenewed\":\"2025-12-19T16:36:58.958Z\",\"createdAt\":\"2025-12-19T16:36:58.959Z\",\"updatedAt\":\"2026-02-13T09:58:09.556Z\",\"__v\":1,\"hasVirtualTour360\":false,\"priceIntervals\":[],\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"hasGeneratedVideo\":false,\"rentalHistory\":[]},{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slotDurationMinutes\":30},\"rentPeriod\":\"monthly\",\"tenantRequirements\":[],\"_id\":\"69457910efaaf095222668f1\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"createdAsRole\":\"private_seller\",\"title\":\"Frozen Yoghurt\",\"status\":\"active\",\"price\":250000,\"address\":\"Rasadnik, Bijelo Polje, Opština Bijelo Polje, 84000, Crna Gora / Црна Гора\",\"city\":\"Bijelo Polje\",\"country\":\"Montenegro\",\"beds\":1,\"baths\":2,\"livingRooms\":2,\"sqft\":45,\"yearBuilt\":2020,\"parking\":2,\"description\":\"Ova moderna komercijalna jedinica predstavlja idealnu priliku za poslovanje sa smrznutim jogurtom, smještena u srcu Balkana. Dizajniran sa naglaskom na funkcionalnost i estetiku, ovaj prostor je spreman za trenutnu upotrebu, pružajući privlačno okruženje za kupce i efikasan rad.Ključne karakteristike:<ul><li>Potpuno opremljen sa profesionalnim mašinama za smrznuti jogurt.</li><li>Atraktivna stanica za samoposluživanje sa raznovrsnim dodacima.</li><li>Moderan i čist enterijer sa udobnim sjedištem za kupce.</li><li>Efikasan raspored pulta sa integrisanim POS sistemom.</li><li>Brending 'YO-ZANI DALIP' već integrisan, spreman za preuzimanje.</li></ul>Materijali i konstrukcija:<ul><li>Podovi od keramičkih pločica za lako održavanje.</li><li>Zidovi u neutralnim tonovima sa modernim LED osvjetljenjem.</li><li>Pultovi i ugradni elementi od visokokvalitetnog laminata u sivoj boji.</li><li>Dodaci za prelive od prozirne plastike i nerđajućeg čelika.</li><li>Profesionalna oprema od nerđajućeg čelika.</li></ul>\",\"specialFeatures\":[\"Seating area\",\"Frozen yogurt machines\",\"Topping bar\",\"POS system\",\"Fully equipped for frozen yogurt business\",\"Modern and clean interior\",\"Efficient layout with integrated POS\",\"Attractive self-serve topping station\",\"Integrated brand signage 'YO-ZANI DALIP'\"],\"materials\":[\"Ceramic floor tiles\",\"Laminate cabinetry\",\"Stainless steel appliances\",\"Acrylic topping dispensers\",\"Solid surface countertops\",\"LED strip lighting\"],\"tourUrl\":\"\",\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766160640/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/rjekigbpanu72aq4jifc.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766160640/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/rjekigbpanu72aq4jifc.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/rjekigbpanu72aq4jifc\",\"tag\":\"other\",\"_id\":\"69457910efaaf095222668f2\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766160643/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/gmfgvl9gkiuesswklohy.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/gmfgvl9gkiuesswklohy\",\"tag\":\"other\",\"_id\":\"69457910efaaf095222668f3\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766160647/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/nstbwbycyft4nwiwua8q.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/nstbwbycyft4nwiwua8q\",\"tag\":\"other\",\"_id\":\"69457910efaaf095222668f4\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766160649/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/g5h1rrgyulv5i1u9wkpj.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/g5h1rrgyulv5i1u9wkpj\",\"tag\":\"other\",\"_id\":\"69457910efaaf095222668f5\"}],\"lat\":43.03188233198664,\"lng\":19.739170074462894,\"propertyType\":\"other\",\"views\":2,\"saves\":0,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"distanceToCenter\":1.8,\"distanceToSchool\":0.7,\"distanceToHospital\":2.1,\"lastRenewed\":\"2025-12-19T16:10:56.641Z\",\"createdAt\":\"2025-12-19T16:10:56.643Z\",\"updatedAt\":\"2026-02-08T11:30:08.261Z\",\"__v\":0,\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"hasVirtualTour360\":false,\"hasGeneratedVideo\":false,\"priceIntervals\":[],\"rentalHistory\":[]},{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slot