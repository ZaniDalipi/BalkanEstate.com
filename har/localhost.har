6e2728876a6f/temp/xkfkshxd6za1r2xu5m6g.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/xkfkshxd6za1r2xu5m6g\",\"tag\":\"other\",\"_id\":\"69405064db2fdf7b3e838f68\"}],\"lat\":42.40191095063363,\"lng\":20.660476684570312,\"propertyType\":\"house\",\"floorNumber\":1,\"totalFloors\":1,\"views\":3,\"saves\":0,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[\"smart home\",\"gym\",\"wifi\",\"super fast wifi\"],\"hasBalcony\":true,\"hasSecurity\":true,\"distanceToCenter\":0.8,\"distanceToSchool\":0.4,\"distanceToHospital\":1.2,\"lastRenewed\":\"2025-12-15T18:16:04.927Z\",\"createdAt\":\"2025-12-15T18:16:04.933Z\",\"updatedAt\":\"2026-02-11T07:58:53.298Z\",\"__v\":1,\"listingType\":\"sale\",\"hasGarden\":false,\"hasElevator\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"hasVirtualTour360\":false,\"hasGeneratedVideo\":false,\"priceIntervals\":[],\"createdAsRole\":\"private_seller\",\"rentPeriod\":\"monthly\",\"rentalHistory\":[],\"tenantRequirements\":[]},{\"visitAvailability\":{\"days\":[1,2,3,4,5],\"enabled\":false,\"endTime\":\"18:00\",\"slotDurationMinutes\":30,\"startTime\":\"09:00\"},\"_id\":\"693de22413c66e2728876adb\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"status\":\"active\",\"price\":29999,\"address\":\"Τσιφλικόπουλου, Λούτσα, Σεισμόπληκτα, Ιωάννινα, Σταυράκι, Δήμος Ιωαννιτών, Περιφερειακή Ενότητα Ιωαννίνων, Περιφέρεια Ηπείρου, Αποκεντρωμένη Διοίκηση Ηπείρου - Δυτικής Μακεδονίας, 455 00, Ελλάς\",\"city\":\"Ioannina\",\"country\":\"Greece\",\"beds\":1,\"baths\":1,\"livingRooms\":1,\"sqft\":60,\"yearBuilt\":1960,\"parking\":1,\"description\":\"Αυτό το διαμέρισμα βρίσκεται σε μια ζωντανή περιοχή των Βαλκανίων, πιθανότατα σε έναν πεζόδρομο γεμάτο ζωή και γιορτινή ατμόσφαιρα, όπως φαίνεται από τα λαμπερά φώτα και την εμπορική δραστηριότητα. Προσφέρει την εμπειρία της αστικής διαβίωσης σε ένα ιστορικό περιβάλλον, με εύκολη πρόσβαση σε τοπικά καταστήματα, καφέ και εστιατόρια. Είναι ιδανικό για όσους αναζητούν την ενέργεια της πόλης και την ευκολία των ανέσεων σε απόσταση αναπνοής.  Βασικά Χαρακτηριστικά:  * Εξαιρετική τοποθεσία σε κεντρικό πεζόδρομο  * Άμεση πρόσβαση σε εμπορικά καταστήματα και εστιατόρια  * Γοητευτικό αστικό περιβάλλον με γιορτινή ατμόσφαιρα  * Θέα στον πεζόδρομο  Υλικά & Κατασκευή:  * Παλιά πέτρινη ή σοβατισμένη τοιχοποιία  * Παραδοσιακά ξύλινα κουφώματα  * Κεραμοσκεπή (στα παρακείμενα κτίρια)  * Πλακόστρωτος πεζόδρομος  * Γυάλινες προσόψεις καταστημάτων στο ισόγειο\",\"specialFeatures\":[\"balcony\",\"Εξαιρετική τοποθεσία σε κεντρικό πεζόδρομο\",\"Άμεση πρόσβαση σε εμπορικά καταστήματα και εστιατόρια\",\"Γοητευτικό αστικό περιβάλλον με γιορτινή ατμόσφαιρα\",\"Θέα στον πεζόδρομο\"],\"materials\":[\"Παλιά πέτρινη ή σοβατισμένη τοιχοποιία\",\"Παραδοσιακά ξύλινα κουφώματα\",\"Κεραμοσκεπή (στα παρακείμενα κτίρια)\",\"Πλακόστρωτος πεζόδρομος\",\"Γυάλινες προσόψεις καταστημάτων στο ισόγειο\"],\"tourUrl\":\"\",\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765663259/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/vaqg56vxsgj64hjcffgq.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765663259/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/vaqg56vxsgj64hjcffgq.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/vaqg56vxsgj64hjcffgq\",\"tag\":\"exterior\",\"_id\":\"693de22413c66e2728876adc\"}],\"lat\":39.655795247556505,\"lng\":20.836086273193363,\"propertyType\":\"apartment\",\"floorNumber\":2,\"views\":4,\"saves\":1,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"distanceToCenter\":4,\"distanceToSea\":65,\"distanceToSchool\":0.8,\"distanceToHospital\":3,\"lastRenewed\":\"2025-12-13T22:01:08.494Z\",\"createdAt\":\"2025-12-13T22:01:08.496Z\",\"updatedAt\":\"2026-02-15T00:45:47.137Z\",\"__v\":1,\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"hasVirtualTour360\":false,\"hasGeneratedVideo\":false,\"priceIntervals\":[],\"createdAsRole\":\"private_seller\",\"rentPeriod\":\"monthly\",\"rentalHistory\":[],\"tenantRequirements\":[]},{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slotDurationMinutes\":30},\"rentPeriod\":\"monthly\",\"tenantRequirements\":[],\"_id\":\"693de18813c66e2728876aa1\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"status\":\"active\",\"price\":2023020000,\"address\":\"Μέλπως Αξιώτη, Φάμπρικα, Κοινότητα Μυκονίων, Μύκονος, Δήμος Μυκόνου, Περιφερειακή Ενότητα Μυκόνου, Περιφέρεια Νοτίου Αιγαίου, Αποκεντρωμένη Διοίκηση Αιγαίου, 846 00, Ελλάς\",\"city\":\"Veria\",\"country\":\"Greece\",\"beds\":3,\"baths\":2,\"livingRooms\":2,\"sqft\":250,\"yearBuilt\":2005,\"parking\":3,\"description\":\"Αυτή η εξαιρετική βίλα, σκαρφαλωμένη στην εμβληματική καλντέρα, προσφέρει μια απαράμιλλη εμπειρία διαβίωσης με εκπληκτική θέα στο Αιγαίο Πέλαγος και τα γύρω νησιά. Συνδυάζοντας την παραδοσιακή κυκλαδίτικη αρχιτεκτονική με σύγχρονες ανέσεις, αποτελεί ένα καταφύγιο ηρεμίας και πολυτέλειας, ιδανικό για όσους αναζητούν την απόλυτη απόδραση στην καρδιά των Βαλκανίων.Key Features: Πανοραμική θέα στην καλντέρα και το απέραντο γαλάζιο του Αιγαίου. Ιδιωτική πισίνα υπερχείλισης που ενώνεται οπτικά με τη θάλασσα. Εκτεταμένες βεράντες πολλαπλών επιπέδων, ιδανικές για χαλάρωση και υπαίθρια γεύματα. Αποκλειστικός σχεδιασμός που ενσωματώνεται αρμονικά στο φυσικό τοπίο. Υψηλό επίπεδο ιδιωτικότητας και ηρεμίας. Παραδοσιακή αισθητική με μοντέρνες πινελιές.Materials & Construction: Εξωτερικοί τοίχοι από λευκό σοβά, χαρακτηριστικό των Κυκλάδων. Ξύλινες πέργκολες και στέγαστρα που προσφέρουν σκιά και προσθέτουν φυσική αισθητική. Σταθερή κατασκευή πάνω στον βράχο, εξασφαλίζοντας ανθεκτικότητα και εκπληκτική θέα. Δάπεδα εξωτερικών χώρων από τσιμέντο/σοβά σε γκρι αποχρώσεις. Χρήση φυσικών υλικών όπως πέτρα για διαμόρφωση του περιβάλλοντος χώρου.\",\"specialFeatures\":[\"swimming pool\",\"terrace\",\"balcony\",\"outdoor dining area\",\"Panoramic caldera views\",\"Traditional Cycladic architecture\",\"Private infinity pool\",\"Multiple spacious outdoor living areas\",\"Cliffside location\",\"Secluded and private ambiance\"],\"materials\":[\"Whitewashed stucco\",\"Stone\",\"Wood\",\"Concrete\",\"Rattan furniture\"],\"tourUrl\":\"\",\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765663102/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/cjepcantc9dhvuftkfce.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765663102/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/cjepcantc9dhvuftkfce.jpg\",\"tag\":\"exterior\",\"_id\":\"694bcbc892194b21475c72dc\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766575037/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/vhdzyger4pagd4zq1v4i.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/vhdzyger4pagd4zq1v4i\",\"tag\":\"other\",\"_id\":\"694bcbc892194b21475c72dd\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766575039/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/fil7lxjv10oz0zxhikdz.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/fil7lxjv10oz0zxhikdz\",\"tag\":\"other\",\"_id\":\"694bcbc892194b21475c72de\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766575040/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/pnahty2ylqlhjev9xed1.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/pnahty2ylqlhjev9xed1\",\"tag\":\"other\",\"_id\":\"694bcbc892194b21475c72df\"}],\"lat\":37.44921392250935,\"lng\":25.32480220494147,\"propertyType\":\"villa\",\"totalFloors\":3,\"views\":5,\"saves\":0,\"inquiries\":2,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"distanceToCenter\":0.8,\"distanceToSea\":0.3,\"distanceToSchool\":1,\"distanceToHospital\":1.8,\"lastRenewed\":\"2025-12-13T21:58:32.537Z\",\"createdAt\":\"2025-12-13T21:58:32.538Z\",\"updatedAt\":\"2026-02-08T11:30:08.261Z\",\"__v\":2,\"createdAsRole\":\"private_seller\",\"hasVirtualTour360\":false,\"title\":\"Μέλπως Αξιώτη, Φάμπρικα, Κοινότητα Μυκονίων, Μύκονος, Δήμος Μυκόνου, Περιφερειακή Ενότητα Μυκόνου, Περιφέρεια Νοτίου Αιγαίου, Αποκεντρωμένη Διοίκηση Αιγαίου, 846 00, Ελλάς\",\"priceIntervals\":[],\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"hasGeneratedVideo\":false,\"rentalHistory\":[]},{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slotDurationMinutes\":30},\"rentPeriod\":\"monthly\",\"tenantRequirements\":[],\"_id\":\"693ddf7a13c66e2728876a76\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"status\":\"active\",\"price\":100000000,\"address\":\"Κοινότητα Γουριωτίσσης, Δημοτική Ενότητα Στράτου, Δήμος Αγρινίου, Περιφερειακή Ενότητα Αιτωλοακαρνανίας, Περιφέρεια Δυτικής Ελλάδας, Αποκεντρωμένη Διοίκηση Πελοποννήσου, Δυτικής Ελλάδας και Ιονίου, Ελλάς\",\"city\":\"Agrinio\",\"country\":\"Greece\",\"beds\":10,\"baths\":4,\"livingRooms\":12,\"sqft\":835,\"yearBuilt\":2005,\"parking\":8,\"description\":\"Αυτό το εξαιρετικό ακίνητο, ένα πραγματικό αρχιτεκτονικό στολίδι στα Βαλκάνια, προσφέρει μια απαράμιλλη εμπειρία πολυτέλειας και ιδιωτικότητας. Σχεδιασμένο για όσους αναζητούν την απόλυτη άνεση και κομψότητα, αυτή η εκτεταμένη ιδιοκτησία συνδυάζει την κλασική γοητεία με τις σύγχρονες ανέσεις, δημιουργώντας ένα ειδυλλιακό καταφύγιο για χαλάρωση και διασκέδαση. Οι πολυάριθμοι χώροι της, τόσο εσωτερικοί όσο και εξωτερικοί, εξασφαλίζουν άφθονο χώρο για κάθε δραστηριότητα, ενώ η προσεγμένη αισθητική και η ποιότητα κατασκευής αναδεικνύουν την υψηλή της αξία.Βασικά Χαρακτηριστικά:<ul><li>Εντυπωσιακή εξωτερική πισίνα σε οργανικό σχήμα, ιδανική για δροσιά και χαλάρωση.</li><li>Πολυτελής υπαίθρια κουζίνα και μπαρ με καθιστικό, ιδανική για κοινωνικές εκδηλώσεις.</li><li>Πολλαπλές βεράντες και μπαλκόνια που προσφέρουν εκπληκτική θέα και ιδιωτικούς χώρους χαλάρωσης.</li><li>Προσεγμένοι διαμορφωμένοι κήποι με πλούσια βλάστηση και φωτισμό, δημιουργώντας μια μαγική ατμόσφαιρα.</li><li>Αρχιτεκτονική που αποπνέει μεγαλοπρέπεια και διαχρονική κομψότητα, με προσοχή στη λεπτομέρεια.</li><li>Άφθονος χώρος για διασκέδαση σε εξωτερικούς χώρους, με ειδικά διαμορφωμένες περιοχές για φαγητό και ηλιοθεραπεία.</li></ul>Υλικά & Κατασκευή:<ul><li>Κομψή πρόσοψη από σοβά σε ανοιχτούς τόνους, προσδίδοντας αρχοντικό ύφος.</li><li>Κεραμοσκεπές σε σκούρα απόχρωση, που συμπληρώνουν αρμονικά την αρχιτεκτονική.</li><li>Εξωτερικές πλακοστρώσεις υψηλής ποιότητας που καλύπτουν τους χώρους της πισίνας και τις αυλές.</li><li>Μεγάλα παράθυρα με πολλαπλά τζάμια που επιτρέπουν την είσοδο του φυσικού φωτός.</li><li>Διακοσμητικά κιγκλιδώματα από σφυρήλατο σίδερο σε μπαλκόνια και σκάλες.</li><li>Σύγχρονα συστήματα φωτισμού εξωτερικού χώρου που αναδεικνύουν την ιδιοκτησία το βράδυ.</li></ul>\",\"specialFeatures\":[\"swimming pool\",\"outdoor kitchen\",\"bar\",\"balcony\",\"garden\",\"terrace\",\"outdoor dining area\",\"Εντυπωσιακή εξωτερική αρχιτεκτονική\",\"Μεγάλη πισίνα σε σχήμα νεφρού\",\"Πολυτελής εξωτερική κουζίνα/μπαρ\",\"Πολλαπλές βεράντες και μπαλκόνια με θέα\",\"Περιποιημένοι κήποι\",\"Ιδανικό για διασκέδαση και χαλάρωση\"],\"materials\":[\"σοβάς\",\"κεραμοσκεπή\",\"πλακόστρωτες αυλές\",\"μεγάλα παράθυρα\",\"σφυρήλατο σίδερο\",\"φωτισμός εξωτερικού χώρου\"],\"tourUrl\":\"\",\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765662581/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/bgy5admv7dq4hps74tfc.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765662581/balkan-estate/property/user-693ddce513c66e2728876a6f/temp/bgy5admv7dq4hps74tfc.jpg\",\"publicId\":\"balkan-estate/property/user-693ddce513c66e2728876a6f/temp/bgy5admv7dq4hps74tfc\",\"tag\":\"exterior\",\"_id\":\"693ddf7a13c66e2728876a77\"}],\"lat\":38.624420925418654,\"lng\":21.25847726136169,\"propertyType\":\"villa\",\"totalFloors\":3,\"views\":0,\"saves\":0,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"distanceToCenter\":12,\"distanceToSea\":45,\"distanceToSchool\":1.5,\"distanceToHospital\":13,\"lastRenewed\":\"2025-12-13T21:49:46.466Z\",\"createdAt\":\"2025-12-13T21:49:46.467Z\",\"updatedAt\":\"2026-02-08T11:30:08.261Z\",\"__v\":0,\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"hasVirtualTour360\":false,\"hasGeneratedVideo\":false,\"priceIntervals\":[],\"createdAsRole\":\"private_seller\",\"rentalHistory\":[]},{\"visitAvailability\":{\"days\":[1,2,3,4,5],\"enabled\":false,\"endTime\":\"18:00\",\"slotDurationMinutes\":30,\"startTime\":\"09:00\"},\"_id\":\"693dd86713c66e27288767cc\",\"sellerId\":{\"_id\":\"693dd37513c66e2728876600\",\"email\":\"agent4@agent.com\",\"name\":\"agent4\",\"phone\":\"+382 2222 2222\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\",\"avatarUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765659531/balkan-estate/avatars/users/693dd37513c66e2728876600/eyftu6jwrhtscftwde30.png\"},\"createdByName\":\"agent4\",\"createdByEmail\":\"agent4@agent.com\",\"status\":\"active\",\"price\":45000,\"address\":\"14, Томе Костића, Турековац, Град Лесковац, Јабланички управни округ, Централна Србија, Србија\",\"city\":\"Leskovac\",\"country\":\"Serbia\",\"beds\":1,\"baths\":1,\"livingRooms\":1,\"sqft\":50,\"yearBuilt\":2018,\"parking\":2,\"description\":\"Predstavljamo Vam jedinstvenu i modernu kontejnersku kuću, idealnu za one koji traže minimalistički životni stil ili savršeno utočište za vikend u prirodi. Smeštena na povišenoj platformi, ova kuća nudi prostranu terasu koja neprimetno spaja unutrašnji i spoljašnji prostor, pružajući izuzetno iskustvo življenja na otvorenom. Sa promišljenim dizajnom i funkcionalnim rasporedom, ova nekretnina je pravi dragulj za ljubitelje savremenog stila i mira.Ključne karakteristike:  - Moderan i inovativan dizajn kontejnerske kuće  - Prostrana povišena terasa savršena za opuštanje i obedovanje na otvorenom  - Kompaktna, ali potpuno opremljena kuhinja sa savremenim aparatima  - Elegantno kupatilo sa modernim pločicama i tuš kabinom  - Velika klizna staklena vrata koja omogućavaju obilje prirodnog svetla i prelep pogled  - Energetski efikasna jedinica za klimatizaciju  - Okružena prirodom, nudi mir i privatnostMaterijali i konstrukcija:  - Glavna konstrukcija od metalnih kontejnerskih modula  - Podna obloga na terasi od kompozitnog drveta  - Unutrašnji podovi obloženi laminatom svetle boje  - Keramičke pločice modernog dizajna u kupatilu  - Aluminijumska stolarija za klizna vrata i prozore  - Bele kuhinjske jedinice sa zlatnim detaljima  - Crne metalne ograde na terasi  - Zlatne sanitarije u kupatilu\",\"specialFeatures\":[\"terrace\",\"outdoor dining area\",\"air conditioning\",\"Moderan dizajn kontejnerske arhitekture\",\"Velika drvena terasa sa nadstrešnicom\",\"Kompaktna, funkcionalna kuhinja sa belim ormarićima\",\"Elegantno kupatilo sa tuš kabinom i modernim pločicama\",\"Panoramska klizna vrata za unutrašnji/spoljašnji život\",\"Povišena konstrukcija sa pogledom na okolinu\",\"Energetski efikasna rešenja\"],\"materials\":[\"metal (container structure)\",\"wood composite decking\",\"laminate flooring\",\"ceramic tiles\",\"glass (sliding doors)\",\"white laminate/MDF cabinetry\",\"black metal railings\",\"gold-colored bathroom fixtures\"],\"tourUrl\":\"\",\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765660765/balkan-estate/property/user-693dd37513c66e2728876600/temp/p8h4lnu7b8kcxk6twknr.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765660765/balkan-estate/property/user-693dd37513c66e2728876600/temp/p8h4lnu7b8kcxk6twknr.jpg\",\"publicId\":\"balkan-estate/property/user-693dd37513c66e2728876600/temp/p8h4lnu7b8kcxk6twknr\",\"tag\":\"exterior\",\"_id\":\"693dd86713c66e27288767cd\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765660766/balkan-estate/property/user-693dd37513c66e2728876600/temp/gkaygu1figo9sdrdeesg.jpg\",\"publicId\":\"balkan-estate/property/user-693dd37513c66e2728876600/temp/gkaygu1figo9sdrdeesg\",\"tag\":\"exterior\",\"_id\":\"693dd86713c66e27288767ce\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765660768/balkan-estate/property/user-693dd37513c66e2728876600/temp/yq3dg3qnvm02k1cx9pya.jpg\",\"publicId\":\"balkan-estate/property/user-693dd37513c66e2728876600/temp/yq3dg3qnvm02k1cx9pya\",\"tag\":\"kitchen\",\"_id\":\"693dd86713c66e27288767cf\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765660770/balkan-estate/property/user-693dd37513c66e2728876600/temp/mjwgsyngg4xtfzqkzog7.jpg\",\"publicId\":\"balkan-estate/property/user-693dd37513c66e2728876600/temp/mjwgsyngg4xtfzqkzog7\",\"tag\":\"bathroom\",\"_id\":\"693dd86713c66e27288767d0\"}],\"lat\":42.988774,\"lng\":21.887641,\"propertyType\":\"apartment\",\"floorNumber\":6,\"totalFloors\":1,\"views\":17,\"saves\":1,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBad