n-estate/property/user-693b1201442f444ce941c70f/temp/rlhcywdosbrm3e8gdv9p.jpg\",\"tag\":\"other\",\"_id\":\"698cf12612e934a1aa8e93ca\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1765894025/balkan-estate/property/user-693b1201442f444ce941c70f/temp/qkvhx3il4fjdeqlzdksf.jpg\",\"tag\":\"other\",\"_id\":\"698cf12612e934a1aa8e93cb\"}],\"lat\":41.71546774903097,\"lng\":21.770095825195316,\"propertyType\":\"house\",\"floorNumber\":1,\"totalFloors\":1,\"views\":41,\"saves\":1,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"lastRenewed\":\"2026-02-06T23:24:32.165Z\",\"createdAt\":\"2025-12-16T14:07:27.802Z\",\"updatedAt\":\"2026-02-15T00:45:31.589Z\",\"__v\":4,\"createdAsRole\":\"private_seller\",\"hasVirtualTour360\":false,\"priceIntervals\":[],\"hasGeneratedVideo\":false,\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"rentPeriod\":\"monthly\",\"rentalHistory\":[],\"tenantRequirements\":[],\"orientation\":\"northEast\"},\"priceAlertEnabled\":true,\"priceAtSave\":0,\"createdAt\":\"2026-02-15T00:45:31.530Z\",\"updatedAt\":\"2026-02-15T00:45:31.530Z\",\"__v\":0},{\"_id\":\"69911728c759be497770247b\",\"userId\":\"693b1201442f444ce941c70f\",\"propertyId\":{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slotDurationMinutes\":30},\"_id\":\"69899d2a3743c3ca6fd9e3d9\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"createdAsRole\":\"agent\",\"createdByAgencyName\":\"Independent Agent\",\"createdByLicenseNumber\":\"Agent-5-555\",\"listingType\":\"sale\",\"title\":\"Apartment(Example)\",\"status\":\"active\",\"price\":850,\"address\":\"Хотел Мериот Скопје, 7, Максим Горки, Пајко Маало, Центар, Скопје, Општина Центар, Град Скопје, 1000, Северна Македонија\",\"city\":\"Skopje\",\"country\":\"North Macedonia\",\"beds\":1,\"baths\":1,\"livingRooms\":2,\"sqft\":50,\"yearBuilt\":2016,\"parking\":0,\"description\":\"Прекрасен апартман лоциран во престижната зграда на Хотел Мериот во срцето на Скопје, на адреса Максим Горки во Пајко Маало, Центар. Оваа ексклузивна локација нуди непосредна близина до клучните градски знаменитости како Плоштад Македонија и Камен мост, обезбедувајќи луксузен живот со сите урбани погодности на дофат. Апартманот е идеална комбинација на модерен дизајн, удобност и елеганција, совршен за индивидуалец или пар кој бара врвен квалитет на живеење во динамичниот центар на градот. Key Features: Модерен и софистициран дизајн на ентериерот со акцент на детали и функционалност. Извонредна локација во Центар, Скопје, со лесен пристап до ресторани, кафулиња и културни настани. Големи прозорци кои овозможуваат обилна природна светлина и нудат поглед кон градот. Елегантно интегрирана бања со врвни елементи и модерен изглед. Висококвалитетен мебел и завршни материјали кои обезбедуваат комфор и луксуз. Materials & Construction: Дрвени облоги и панели кои внесуваат топлина и софистицираност во просторот. Декоративни ѕидни тапети со модерен дезен, додавајќи текстура и стил. Квалитетни меки подни облоги (теписи) во спалната соба за максимална удобност. Елегантни керамички плочки и мермерни површини во бањата, отсликувајќи луксуз. Стаклени прегради кои го максимизираат просторот и ја зголемуваат светлината. Модерни метални и стаклени елементи во осветлувањето и декорацијата.\",\"specialFeatures\":[\"балкон\",\"работна површина\",\"интегрирана бања\",\"хотелски лоби/салон\",\"Модерен дизајн и ентериер\",\"Врвна локација во Центар, Скопје\",\"Природна светлина\",\"Висококвалитетни завршни материјали\",\"Современ мебел\",\"Поглед кон град\"],\"materials\":[\"Дрвени облоги\",\"Декоративен ѕиден тапет\",\"Меки подни облоги (тепих)\",\"Керамички плочки (бања)\",\"Стаклени прегради\",\"Метални акценти\",\"Мермерни површини\"],\"tourUrl\":\"https://www.instagram.com/reel/DLK6-kgiEnr/?utm_source=ig_web_button_share_sheet&igsh=MzRlODBiNWFlZA==\",\"virtualTour360Url\":\"https://z360-virtual-tour.vercel.app/embed/Saraj\",\"hasVirtualTour360\":true,\"hasGeneratedVideo\":false,\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626333/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/i1hsgtdtx1mshbhh8vkk.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626333/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/i1hsgtdtx1mshbhh8vkk.jpg\",\"tag\":\"exterior\",\"_id\":\"69899d6d3743c3ca6fd9e63f\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626335/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/lcjqzfxikmx1pkk4r7q6.jpg\",\"tag\":\"bedroom\",\"_id\":\"69899d6d3743c3ca6fd9e640\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626336/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/ijxw5krhb85b8hcz1bui.jpg\",\"tag\":\"bedroom\",\"_id\":\"69899d6d3743c3ca6fd9e641\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626337/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/xejwmrszanw0lnnge3px.jpg\",\"tag\":\"exterior\",\"_id\":\"69899d6d3743c3ca6fd9e642\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626339/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/dwe7ipsu5ryzzpazgti3.jpg\",\"tag\":\"other\",\"_id\":\"69899d6d3743c3ca6fd9e643\"}],\"lat\":41.9960984,\"lng\":21.4304852,\"propertyType\":\"apartment\",\"floorNumber\":4,\"totalFloors\":8,\"views\":5,\"saves\":2,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":true,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"dista