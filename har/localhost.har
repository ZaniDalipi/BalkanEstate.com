695be10c80679228babedb41\",\"email\":\"zanoin@gmail.com\",\"name\":\"zanoin\",\"phone\":\"\",\"role\":\"agent\",\"avatarUrl\":\"https://lh3.googleusercontent.com/a/ACg8ocKCA_06RroFGk5AxgtICgnhVp3kg5mAlM0aKsccTqjSrS5rmsJf-g=s400-c\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"zanoin\",\"createdByEmail\":\"zanoin@gmail.com\",\"createdAsRole\":\"agent\",\"createdByAgencyName\":\"Independent Agent\",\"createdByLicenseNumber\":\"Zano-11111\",\"listingType\":\"sale\",\"title\":\"Apartament ne shitje\",\"status\":\"active\",\"price\":42000,\"address\":\"Jumbo, Rruga Egnatia, Durrës, Bashkia Durrës, Qarku i Durrësit, Shqipëria Veriore, 2001, Shqipëria\",\"city\":\"Durres\",\"country\":\"Albania\",\"beds\":2,\"baths\":3,\"livingRooms\":3,\"sqft\":75,\"yearBuilt\":2026,\"parking\":2,\"description\":\"test \",\"specialFeatures\":[\"#special\",\"pool\",\"ontop\",\"amazing\"],\"materials\":[\"wood\",\"parket\",\"stone design\"],\"tourUrl\":\"https://www.instagram.com/reel/DHW9kpxP9An/?igsh=MTZzZGl3cmdreWE3Nw==\",\"virtualTour360Url\":\"https://z360-virtual-tour.vercel.app/embed/Saraj\",\"hasVirtualTour360\":true,\"hasGeneratedVideo\":false,\"imageUrl\":\"https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=500\",\"images\":[],\"lat\":41.3153275,\"lng\":19.4507249,\"propertyType\":\"apartment\",\"floorNumber\":8,\"totalFloors\":12,\"views\":15,\"saves\":2,\"inquiries\":1,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[\"pool\",\"tennis field\"],\"hasBalcony\":true,\"hasGarden\":true,\"hasElevator\":true,\"hasSecurity\":true,\"hasAirConditioning\":true,\"hasPool\":true,\"petsAllowed\":false,\"distanceToCenter\":2.5,\"distanceToSea\":1.8,\"distanceToSchool\":0.7,\"distanceToHospital\":2.5,\"furnishing\":\"furnished\",\"heatingType\":\"electric\",\"condition\":\"new\",\"viewType\":\"sea\",\"energyRating\":\"A+\",\"orientation\":\"northEast\",\"rentPeriod\":\"monthly\",\"tenantRequirements\":[],\"priceIntervals\":[],\"lastRenewed\":\"2026-02-12T17:07:00.319Z\",\"rentalHistory\":[],\"createdAt\":\"2026-02-12T17:07:00.321Z\",\"updatedAt\":\"2026-02-15T01:12:04.954Z\",\"__v\":0},{\"visitAvailability\":{\"enabled\":false,\"days\":[1,2,3,4,5],\"startTime\":\"09:00\",\"endTime\":\"18:00\",\"slotDurationMinutes\":30},\"_id\":\"69899d2a3743c3ca6fd9e3d9\",\"sellerId\":{\"_id\":\"693ddce513c66e2728876a6f\",\"email\":\"agent5@agent.com\",\"name\":\"agent5\",\"phone\":\"071967915\",\"role\":\"agent\",\"agencyName\":\"Independent Agent\"},\"createdByName\":\"agent5\",\"createdByEmail\":\"agent5@agent.com\",\"createdAsRole\":\"agent\",\"createdByAgencyName\":\"Independent Agent\",\"createdByLicenseNumber\":\"Agent-5-555\",\"listingType\":\"sale\",\"title\":\"Apartment(Example)\",\"status\":\"active\",\"price\":850,\"address\":\"Хотел Мериот Скопје, 7, Максим Горки, Пајко Маало, Центар, Скопје, Општина Центар, Град Скопје, 1000, Северна Македонија\",\"city\":\"Skopje\",\"country\":\"North Macedonia\",\"beds\":1,\"baths\":1,\"livingRooms\":2,\"sqft\":50,\"yearBuilt\":2016,\"parking\":0,\"description\":\"Прекрасен апартман лоциран во престижната зграда на Хотел Мериот во срцето на Скопје, на адреса Максим Горки во Пајко Маало, Центар. Оваа ексклузивна локација нуди непосредна близина до клучните градски знаменитости како Плоштад Македонија и Камен мост, обезбедувајќи луксузен живот со сите урбани погодности на дофат. Апартманот е идеална комбинација на модерен дизајн, удобност и елеганција, совршен за индивидуалец или пар кој бара врвен квалитет на живеење во динамичниот центар на градот. Key Features: Модерен и софистициран дизајн на ентериерот со акцент на детали и функционалност. Извонредна локација во Центар, Скопје, со лесен пристап до ресторани, кафулиња и културни настани. Големи прозорци кои овозможуваат обилна природна светлина и нудат поглед кон градот. Елегантно интегрирана бања со врвни елементи и модерен изглед. Висококвалитетен мебел и завршни материјали кои обезбедуваат комфор и луксуз. Materials & Construction: Дрвени облоги и панели кои внесуваат топлина и софистицираност во просторот. Декоративни ѕидни тапети со модерен дезен, додавајќи текстура и стил. Квалитетни меки подни облоги (теписи) во спалната соба за максимална удобност. Елегантни керамички плочки и мермерни површини во бањата, отсликувајќи луксуз. Стаклени прегради кои го максимизираат просторот и ја зголемуваат светлината. Модерни метални и стаклени елементи во осветлувањето и декорацијата.\",\"specialFeatures\":[\"балкон\",\"работна површина\",\"интегрирана бања\",\"хотелски лоби/салон\",\"Модерен дизајн и ентериер\",\"Врвна локација во Центар, Скопје\",\"Природна светлина\",\"Висококвалитетни завршни материјали\",\"Современ мебел\",\"Поглед кон град\"],\"materials\":[\"Дрвени облоги\",\"Декоративен ѕиден тапет\",\"Меки подни облоги (тепих)\",\"Керамички плочки (бања)\",\"Стаклени прегради\",\"Метални акценти\",\"Мермерни површини\"],\"tourUrl\":\"https://www.instagram.com/reel/DLK6-kgiEnr/?utm_source=ig_web_button_share_sheet&igsh=MzRlODBiNWFlZA==\",\"virtualTour360Url\":\"https://z360-virtual-tour.vercel.app/embed/Saraj\",\"hasVirtualTour360\":true,\"hasGeneratedVideo\":false,\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626333/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/i1hsgtdtx1mshbhh8vkk.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626333/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/i1hsgtdtx1mshbhh8vkk.jpg\",\"tag\":\"exterior\",\"_id\":\"69899d6d3743c3ca6fd9e63f\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626335/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/lcjqzfxikmx1pkk4r7q6.jpg\",\"tag\":\"bedroom\",\"_id\":\"69899d6d3743c3ca6fd9e640\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1770626336/balkan-estate/users/693ddce513c66e2728876a6f/listings/temp/ijxw5krhb85b8hcz1bui.jpg\",\"tag\":\"bedroom\",\"_id\":\"69899d6d3743c3ca6fd9e641\"},{\"url\":\"https