pload/v1768932750/balkan-estate/agencies/693b1f0b442f444ce941c8a8/logo/bu8xdhegqhx7wkhrvxie.jpg\"},\"createdByName\":\"agent1\",\"createdByEmail\":\"agent1@agent.com\",\"createdAsRole\":\"private_seller\",\"title\":\"Example 11\",\"status\":\"active\",\"price\":400000,\"address\":\"Dalmatia Tower, 61A, Ulica Domovinskog rata, Gradski kotar Ravne njive, Split, Grad Split, Splitsko-dalmatinska županija, 21000, Hrvatska\",\"city\":\"Split\",\"country\":\"Croatia\",\"beds\":0,\"baths\":0,\"livingRooms\":0,\"sqft\":100,\"yearBuilt\":2015,\"parking\":0,\"description\":\"Uronite u svijet luksuza i sofisticiranosti s ovim iznimnim apartmanom smještenim u srcu urbanog pejzaža, unutar ikoničnog nebodera koji dominira horizontom. Ovaj moderni dom nudi ne samo vrhunski životni prostor već i pristup ekskluzivnim sadržajima koji osiguravaju udobnost i prestiž. S panoramskim pogledom na grad i more, svaki dan postaje iskustvo neusporedive ljepote i mira, idealno za one koji traže urbanu oazu s daškom glamura. Ključne značajke: - Panoramski pogled na grad i more iz visokog kata- Pristup luksuznom unutarnjem bazenu s ležaljkama- Veličanstveno predvorje s impozantnim stubištem i recepcijom- Moderan dizajn zgrade i interijera, simbol prestiža Materijali i izgradnja: - Fasada od stakla i visokokvalitetnih kompozitnih materijala- Interijeri zajedničkih prostora obloženi kamenom (stubište, podovi) i drvenim panelima- Elegantna rasvjetna tijela i dizajnerski namještaj u zajedničkim prostorima- Korištenje premium materijala za dugotrajnost i estetiku\",\"specialFeatures\":[\"unutarnji bazen\",\"luksuzno predvorje\",\"panoramski pogled\",\"Panoramski pogled na grad i more\",\"Pristup luksuznom unutarnjem bazenu\",\"Veličanstveno predvorje s recepcijom\",\"Moderan dizajn i prestižna lokacija\"],\"materials\":[\"staklena fasada\",\"kameni podovi\",\"drveni paneli\",\"dizajnerska rasvjeta\",\"moderni kompozitni materijali\"],\"tourUrl\":\"https://www.youtube.com/watch?v=zcSMh8pMpPI\",\"hasVirtualTour360\":false,\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769467831/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/rbdmvhvwmecpot7oxtwh.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769467831/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/rbdmvhvwmecpot7oxtwh.jpg\",\"publicId\":\"balkan-estate/users/693b1201442f444ce941c70f/listings/temp/rbdmvhvwmecpot7oxtwh\",\"tag\":\"other\",\"_id\":\"6977efc2ae05f6696bb7368c\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769467833/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/hatod0mi41vcl36kf8mf.jpg\",\"publicId\":\"balkan-estate/users/693b1201442f444ce941c70f/listings/temp/hatod0mi41vcl36kf8mf\",\"tag\":\"other\",\"_id\":\"6977efc2ae05f6696bb7368d\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769467834/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/wmbv2yq5csnnkzzd9bll.jpg\",\"publicId\":\"balkan-estate/users/693b1201442f444ce941c70f/listings/temp/wmbv2yq5csnnkzzd9bll\",\"tag\":\"exterior\",\"_id\":\"6977efc2ae05f6696bb7368e\"}],\"lat\":43.5203328,\"lng\":16.4508911,\"propertyType\":\"apartment\",\"floorNumber\":28,\"totalFloors\":28,\"views\":15,\"saves\":2,\"inquiries\":0,\"isPromoted\":true,\"hasUrgentBadge\":false,\"amenities\":[],\"hasBalcony\":true,\"hasGarden\":true,\"hasElevator\":true,\"hasSecurity\":true,\"hasAirConditioning\":true,\"hasPool\":true,\"petsAllowed\":true,\"distanceToCenter\":2.7,\"distanceToSea\":1.5,\"distanceToSchool\":0.5,\"distanceToHospital\":3.2,\"furnishing\":\"semi-furnished\",\"heatingType\":\"electric\",\"condition\":\"excellent\",\"viewType\":\"sea\",\"energyRating\":\"A+\",\"priceIntervals\":[],\"lastRenewed\":\"2026-02-06T23:20:55.370Z\",\"createdAt\":\"2026-01-26T22:50:42.148Z\",\"updatedAt\":\"2026-02-15T00:02:40.581Z\",\"__v\":1,\"hasGeneratedVideo\":false,\"promotionEndDate\":\"2026-03-08T23:19:28.127Z\",\"promotionStartDate\":\"2026-02-