4b517cd24b\"}],\"lat\":42.38847290951027,\"lng\":18.915367126464847,\"propertyType\":\"villa\",\"floorNumber\":1,\"totalFloors\":1,\"views\":18,\"saves\":1,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"lastRenewed\":\"2026-02-06T23:22:48.866Z\",\"createdAt\":\"2025-12-18T06:11:08.673Z\",\"updatedAt\":\"2026-02-15T00:45:35.256Z\",\"__v\":3,\"hasVirtualTour360\":false,\"priceIntervals\":[],\"hasGeneratedVideo\":false,\"listingType\":\"sale\",\"hasBalcony\":false,\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"petsAllowed\":false,\"rentPeriod\":\"monthly\",\"rentalHistory\":[],\"tenantRequirements\":[]},{\"visitAvailability\":{\"days\":[1,2,3,4,5],\"enabled\":false,\"endTime\":\"18:00\",\"slotDurationMinutes\":30,\"startTime\":\"09:00\"},\"_id\":\"69769be6618d8ce12db9ed62\",\"sellerId\":{\"_id\":\"693b1201442f444ce941c70f\",\"email\":\"agent1@agent.com\",\"name\":\"agent1\",\"phone\":\"+389 71 111 111\",\"role\":\"agent\",\"agencyName\":\"Horizon Property Group (agent 1)\",\"agencyId\":\"693b1f0b442f444ce941c8a8\",\"agencyLogo\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1768932750/balkan-estate/agencies/693b1f0b442f444ce941c8a8/logo/bu8xdhegqhx7wkhrvxie.jpg\"},\"createdByName\":\"agent1\",\"createdByEmail\":\"agent1@agent.com\",\"createdAsRole\":\"private_seller\",\"title\":\"Example 12\",\"status\":\"active\",\"price\":1500000,\"address\":\"AC Hotel by Marriott Split, 61A, Ulica Domovinskog rata, Gradski kotar Ravne njive, Split, Grad Split, Splitsko-dalmatinska županija, 21000, Hrvatska\",\"city\":\"Split\",\"country\":\"Croatia\",\"beds\":3,\"baths\":2,\"livingRooms\":2,\"sqft\":100,\"yearBuilt\":2023,\"parking\":0,\"description\":\"Predstavljamo vam izniman moderni apartman smješten na atraktivnoj lokaciji na Balkanu, koji nudi savršen spoj luksuza, udobnosti i spektakularnog pogleda. Ovaj elegantno dizajniran dom idealan je za one koji traže suvremeni životni prostor s otvorenim tlocrtom i obiljem prirodnog svjetla. Velike staklene površine pružaju prekrasne panoramske poglede na more i okolno zelenilo, stvarajući opuštajuću atmosferu u svakom kutku. Apartman je opremljen najkvalitetnijim materijalima i suvremenom opremom, što ga čini spremnim za useljenje bez dodatnih ulaganja. Ključne Značajke: * Prostrani otvoreni tlocrt koji spaja dnevni boravak, blagovaonicu i kuhinju, osiguravajući prozračnost i funkcionalnost. * Staklene stijene od poda do stropa s izlazom na prostrani balkon/terasu, nudeći neometane panoramske poglede na more i krajolik. * Moderna kuhinja s otokom, opremljena integriranim vrhunskim aparatima i elegantnim mramornim radnim pločama. * Kvalitetni završni materijali, uključujući svijetle keramičke pločice i drvene elemente, doprinoseći sofisticiranom izgledu. * Suvremeni minimalistički dizajn interijera, s pažljivo odabranim detaljima i neutralnim paletama boja. * Dva odvojena dnevna boravka, pružajući fleksibilnost i dodatni prostor za opuštanje ili rad. Materijali i Konstrukcija: * Podovi obloženi visokokvalitetnim keramičkim pločicama u svijetlim nijansama, koje imitiraju kamen ili drvo. * Mramorne površine korištene na kuhinjskom otoku, dodajući element luksuza i izdržljivosti. * Zidovi pretežno obojani u bijelo s elegantnim sivim naglascima, stvarajući modernu i svježu estetiku. * Vanjska stolarija od velikih staklenih panela osigurava maksimalan prodor svjetlosti i izvrsnu toplinsku izolaciju. * Kuhinjski elementi izrađeni od kombinacije drva i medijapana s modernim, glatkim frontama. * Integrirana stropna rasvjeta i stropni ventilatori za optimalnu udobnost i funkcionalnost.\",\"specialFeatures\":[\"Balkon/terasa\",\"Stropni ventilator\",\"Ugradbeni kuhinjski aparati\",\"Panoramski pogled\",\"Prostrani otvoreni tlocrt\",\"Staklene stijene od poda do stropa\",\"Moderna kuhinja s otokom\",\"Kvalitetni završni materijali\",\"Suvremeni minimalistički dizajn\",\"Dva odvojena dnevna boravka\"],\"materials\":[\"Keramičke pločice\",\"Mramor\",\"Obojani zidovi\",\"Staklo\",\"Nehrđajući čelik\",\"Drvo\"],\"tourUrl\":\"https://www.instagram.com/reel/DHW9kpxP9An/?utm_source=ig_web_button_share_sheet\",\"hasVirtualTour360\":false,\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769380822/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/rib9wpxbgtdrirbt5ein.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769380822/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/rib9wpxbgtdrirbt5ein.jpg\",\"tag\":\"living_room\",\"_id\":\"6977ed96ae05f6696bb72e92\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769380824/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/iiojeakickx6whrhvmx2.jpg\",\"tag\":\"living_room\",\"_id\":\"6977ed96ae05f6696bb72e93\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769380826/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/jge4i8hdheuyiu5zngk5.jpg\",\"tag\":\"kitchen\",\"_id\":\"6977ed96ae05f6696bb72e94\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769380828/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/qtrfmpfdgtjky1niaq02.jpg\",\"tag\":\"living_room\",\"_id\":\"6977ed96ae05f6696bb72e95\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769380829/balkan-estate/users/693b1201442f444ce941c70f/listings/temp/v1spcljfieypxo3kn6ek.jpg\",\"tag\":\"living_room\",\"_id\":\"6977ed96ae05f6696bb72e96\"}],\"lat\":43.520300417865705,\"lng\":16.45084083080292,\"propertyType\":\"apartment\",\"floorNumber\":18,\"totalFloors\":28,\"views\":38,\"saves\":1,\"inquiries\":0,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"distanceToCenter\":3,\"distanceToSea\":2,\"distanceToSchool\":0.7,\"distanceToHospital\":2.5,\"priceIntervals\":[],\"lastRenewed\":\"2026-02-06T23:22:45.723Z\",\"createdAt\":\"2026-01-25T22:40:38.782Z\",\"updatedAt\":\"2026-02-13T20:04:35.279Z\",\"__v\":2,\"hasG