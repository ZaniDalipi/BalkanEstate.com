"_id\":\"6977f587ae05f6696bb763fa\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769356698/balkan-estate/users/697636de99a6fabcc63fe0cd/listings/temp/u3w7vtnt1jeocefgi5ke.jpg\",\"tag\":\"kitchen\",\"_id\":\"6977f587ae05f6696bb763fb\"},{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1769356699/balkan-estate/users/697636de99a6fabcc63fe0cd/listings/temp/j18zdecdbdahdclwe995.jpg\",\"tag\":\"living_room\",\"_id\":\"6977f587ae05f6696bb763fc\"}],\"lat\":41.32745321502558,\"lng\":19.821602404117588,\"propertyType\":\"apartment\",\"floorNumber\":8,\"totalFloors\":15,\"views\":104,\"saves\":1,\"inquiries\":1,\"isPromoted\":false,\"hasUrgentBadge\":false,\"amenities\":[],\"hasBalcony\":true,\"petsAllowed\":true,\"distanceToCenter\":0.1,\"distanceToSea\":32,\"distanceToSchool\":0.5,\"distanceToHospital\":1.8,\"priceIntervals\":[],\"lastRenewed\":\"2026-01-25T15:58:28.977Z\",\"createdAt\":\"2026-01-25T15:58:28.979Z\",\"updatedAt\":\"2026-02-15T00:02:37.980Z\",\"__v\":5,\"tourUrl\":\"https://www.youtube.com/watch?v=Q1zX5PuposA\",\"videoUrl\":\"https://res.cloudinary.com/dh8tbq8wy/video/upload/v1769644484/balkan-estate/users/697636de99a6fabcc63fe0cd/listings/69763da4eef98ca313500351/videos/ujenw7z3vtlnhm2tugwr.mp4\",\"listingType\":\"sale\",\"hasGarden\":false,\"hasElevator\":false,\"hasSecurity\":false,\"hasAirConditioning\":false,\"hasPool\":false,\"hasGeneratedVideo\":false,\"rentPeriod\":\"monthly\",\"rentalHistory\":[],\"tenantRequirements\":[]},{\"visitAvailability\":{\"days\":[1,2,3,4,5],\"enabled\":false,\"endTime\":\"18:00\",\"slotDurationMinutes\":30,\"startTime\":\"09:00\"},\"_id\":\"69510c06d3bb78c085580f5c\",\"sellerId\":{\"_id\":\"693b1201442f444ce941c70f\",\"email\":\"agent1@agent.com\",\"name\":\"agent1\",\"phone\":\"+389 71 111 111\",\"role\":\"agent\",\"agencyName\":\"Horizon Property Group (agent 1)\",\"agencyId\":\"693b1f0b442f444ce941c8a8\",\"agencyLogo\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1768932750/balkan-estate/agencies/693b1f0b442f444ce941c8a8/logo/bu8xdhegqhx7wkhrvxie.jpg\"},\"createdByName\":\"agent1\",\"createdByEmail\":\"agent1@agent.com\",\"createdAsRole\":\"agent\",\"createdByAgencyName\":\"Horizon Property Group (agent 1)\",\"createdByLicenseNumber\":\"BG-REA-44219\",\"title\":\"Example\",\"status\":\"active\",\"price\":350000,\"address\":\"Rruga Livadheve, Lagjja 1, Shkodër, Bashkia Shkodër, Qarku i Shkodrës, Shqipëria Veriore, 4005, Shqipëria\",\"city\":\"Shkoder\",\"country\":\"Albania\",\"beds\":2,\"baths\":2,\"livingRooms\":2,\"sqft\":75,\"yearBuilt\":1995,\"parking\":2,\"description\":\"Ky imazh paraqet një rrugë tregtare të ndriçuar bukur gjatë natës, e dekoruar me drita festash, duke krijuar një atmosferë të gjallë dhe mikpritëse. Edhe pse apartamenti nuk shfaqet direkt në imazh, vendndodhja e tij në një zonë kaq të gjallë urbane, me dyqane dhe kafene afër, sugjeron një jetë dinamike dhe komoditete të shumta në dorë. Kjo pronë, e pozicionuar në një zemër të tillë qyteti, ofron mundësinë për të shijuar pulsacionin e jetës urbane ballkanase, duke qenë një zgjedhje ideale për ata që kërkojnë lehtësi dhe argëtim pranë shtëpisë.Key Features:* Vendndodhje qendrore, afër dyqaneve dhe restoranteve.* Qasje e lehtë në transportin publik.* Potencial për një stil jetese aktive dhe urbane.Materials & Construction:* Mure prej betoni/tullash (supozuar për ndërtime urbane).* Suva e lyer për fasadën e jashtme.* Pllaka qeramike ose parket (supozuar për brendësi apartamentesh).\",\"specialFeatures\":[\"balcony\",\"Urban lifestyle\",\"Close to amenities\",\"Vibrant neighborhood\"],\"materials\":[\"Concrete\",\"Plaster\",\"Ceramic tiles\"],\"hasVirtualTour360\":true,\"imageUrl\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766919156/balkan-estate/property/user-693b1201442f444ce941c70f/temp/bmzqqhqmri1ijxsaqkcu.jpg\",\"images\":[{\"url\":\"https://res.cloudinary.com/dh8tbq8wy/image/upload/v1766919156/balkan-estate/property/user-693b1201442f444ce941c70f/temp/bmzqqhq