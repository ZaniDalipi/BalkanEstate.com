# ============================================================
# Push Notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@balkanestateai.com

# ============================================================
# Media / Cloudinary
# ============================================================
# External feed images are NEVER stored on Cloudinary — listings reference the
# source site's URL and the image is fetched live when a visitor views it.
# Only if you set this to true will a source with adapterConfig.rehostImages
# copy its photos into balkan-estate/external-feeds/{source}/{listing}.
# ALLOW_EXTERNAL_IMAGE_REHOST=false

# How long listing media stays in Cloudinary after the listing ends (years).
# Deleted listings keep one archive thumbnail; sold listings keep their photos.
# MEDIA_RETENTION_DELETED_YEARS=1
# MEDIA_RETENTION_SOLD_YEARS=2

# External image proxy cache (/api/image-proxy)
# IMAGE_PROXY_MEMORY_MB=64
# IMAGE_PROXY_DISK_MB=512
# IMAGE_PROXY_CACHE_DAYS=7
# IMAGE_PROXY_CACHE_DIR=/tmp/balkan-image-proxy

# ============================================================
# Unsplash — destination photo seeding
# ============================================================
# Access key for the Unsplash API, used only by
# `npm run seed:destination-images`. That script fills in a photo for villa
# destinations that do not have one; it never replaces a photo an admin
# uploaded. Create a key at https://unsplash.com/oauth/applications.
UNSPLASH_ACCESS_KEY=

# ============================================================
# Agency property-feed imports (Agency Dashboard → Property Imports)
# ============================================================
# Docs: docs/integrations/agency-feeds/README.md
#
# Where the scheduler and import jobs run:
#   (unset)   — not in the API process; run `npm run start:worker:feeds`
#               (or the `feed-worker` service in docker-compose.prod.yml).
#   embedded  — inside the API process. Fine for development or a single
#               small container; prefer the separate worker in production.
# AGENCY_FEED_WORKER_MODE=
#
# How imported photos and floor plans are stored:
#   rehost    (default) — uploaded through the normal Cloudinary pipeline
#                         (same compression, folders, tags and delivery presets).
#   reference           — validated, but served from the agency's own URL
#                         through /api/image-proxy. No storage cost; photos
#                         break if the agency's site removes them.
# AGENCY_FEED_IMAGE_MODE=rehost
#
# Hours between scheduled syncs of each active feed (minimum 1).
# AGENCY_FEED_SYNC_INTERVAL_HOURS=24
# Per-feed limits: download size (MB), listings, pages, total fetch time.
# AGENCY_FEED_MAX_MB=50
# AGENCY_FEED_MAX_LISTINGS=10000
# AGENCY_FEED_MAX_PAGES=50
# AGENCY_FEED_FETCH_TIMEOUT_MS=120000
# Worker: parallel import jobs per process, and queue polling interval.
# AGENCY_FEED_WORKER_CONCURRENCY=2
# AGENCY_FEED_POLL_INTERVAL_MS=5000
#
# Feed credentials are encrypted with FIELD_ENCRYPTION_KEY (falls back to
# ENCRYPTION_KEY) — the worker must have the same key as the API.
