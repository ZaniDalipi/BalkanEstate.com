# ============================================================
# Push Notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@balkanestateai.com

# ============================================================
# Media / Cloudinary
# ============================================================
# In development, scraped external listing images are NEVER uploaded to
# Cloudinary — they reference the source URL directly. No configuration needed.

# ============================================================
# Unsplash — destination photo seeding
# ============================================================
# Access key for the Unsplash API, used only by
# `npm run seed:destination-images`. That script fills in a photo for villa
# destinations that do not have one; it never replaces a photo an admin
# uploaded. Create a key at https://unsplash.com/oauth/applications.
UNSPLASH_ACCESS_KEY=

# ============================================================
# Social sharing — new listings to Facebook Page & Instagram
# ============================================================
# Every new listing lands in Admin → Social Sharing and is only posted after an
# admin approves it. Leave these blank and the queue still works: approve, then
# use "Copy text & open group" to post into the Facebook group by hand.
# Setup steps: docs/SOCIAL_SHARING.md
FACEBOOK_PAGE_ID=
# Long-lived Page access token (pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish). Keep it secret.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram Business/Creator account linked to the Page above
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# The group you share into by hand (Meta has no API for posting in groups)
FACEBOOK_GROUP_URL=
# META_GRAPH_API_VERSION=v21.0
