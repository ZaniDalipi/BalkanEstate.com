# ============================================================
# Push Notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@balkanestateai.com

# ============================================================
# Media / Bunny.net
# ============================================================
# Images live in a Bunny Edge Storage zone and are served through a pull zone
# with Bunny Optimizer enabled (that is what makes ?width=…&quality=… work).
#
# In development, scraped external listing images are NEVER re-hosted — they
# reference the source URL directly — and uploads are refused rather than
# silently dropped when these are unset. No configuration needed to run locally.

# Storage zone name and its FTP & API password (dashboard → Storage → FTP &
# API Access). This password can delete the whole zone; never expose it.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=

# Storage region prefix. Empty = Falkenstein (DE), Bunny's default.
# Others: ny, la, sg, syd, uk, se, br, jh — must match the zone's region.
BUNNY_STORAGE_REGION=

# Public CDN hostname of the pull zone, without scheme.
# e.g. balkanestate.b-cdn.net, or a custom domain pointed at the pull zone.
# Must match VITE_CDN_HOST in the frontend build.
BUNNY_PULL_ZONE_HOST=

# ── Private documents (agent licenses and credentials) ──────────────────────
# A SECOND pull zone over the same storage zone, with Token Authentication
# enabled. It has to be separate: Bunny applies token auth to an entire pull
# zone, so switching it on for the hostname above would make every listing
# photo require a signature. Leave blank if no documents are uploaded.
BUNNY_PRIVATE_PULL_ZONE_HOST=

# The private pull zone's token authentication key (dashboard → Security →
# Token Authentication). Without it, signing a document URL fails loudly
# rather than handing out a publicly readable one.
BUNNY_TOKEN_AUTH_KEY=

# ── Cloudinary (legacy) ─────────────────────────────────────────────────────
# Only read by `npm run migrate:images`, the one-time script that copies
# existing assets across. Remove once that has run clean and the account is
# closed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# Unsplash — destination photo seeding
# ============================================================
# Access key for the Unsplash API, used only by
# `npm run seed:destination-images`. That script fills in a photo for villa
# destinations that do not have one; it never replaces a photo an admin
# uploaded. Create a key at https://unsplash.com/oauth/applications.
UNSPLASH_ACCESS_KEY=
