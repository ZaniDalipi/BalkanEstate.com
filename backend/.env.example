# ============================================================
# Push Notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@balkanestateai.com

# ============================================================
# Media / Cloudinary
# ============================================================
# In development, scraped external listing images are NEVER uploaded to
# Cloudinary — they reference the source URL directly. No configuration needed.

# ============================================================
# Unsplash — destination photo seeding
# ============================================================
# Access key for the Unsplash API, used only by
# `npm run seed:destination-images`. That script fills in a photo for villa
# destinations that do not have one; it never replaces a photo an admin
# uploaded. Create a key at https://unsplash.com/oauth/applications.
UNSPLASH_ACCESS_KEY=
