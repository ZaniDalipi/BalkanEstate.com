# ============================================================
# Push Notifications (Web Push / VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@balkanestateai.com

# ============================================================
# Media / Cloudinary
# ============================================================
# Scraped external listing images are NOT re-hosted on Cloudinary outside
# production (they reference the source URL directly) to avoid eating storage
# in local/dev. Set this to "true" to force real Cloudinary uploads in dev.
CLOUDINARY_REHOST_IN_DEV=false
