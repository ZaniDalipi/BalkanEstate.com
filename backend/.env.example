# =============================================================================
# Backend Environment Variables
# =============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/balkanestate

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for sensitive data)
ENCRYPTION_KEY=your-32-character-encryption-key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# Payment Provider - Paddle (Primary)
# =============================================================================
# Paddle is used for all countries as Merchant of Record (MoR)
# Benefits: Handles VAT/tax compliance, chargeback protection, global coverage
# Get credentials from: https://vendors.paddle.com/

# Paddle API Credentials (REQUIRED)
PADDLE_API_KEY=pdl_...
PADDLE_CLIENT_TOKEN=ctk_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs (create products in Paddle Dashboard → Catalog → Products)
PADDLE_PRICE_BUYER_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_YEARLY=pri_...
PADDLE_PRICE_AGENCY_MONTHLY=pri_...
PADDLE_PRICE_AGENCY_YEARLY=pri_...

# =============================================================================
# Stripe (Optional - Fallback)
# =============================================================================
# Only needed if you want Stripe as a fallback provider
# Get credentials from: https://dashboard.stripe.com/

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backend URL (for webhooks)
BACKEND_URL=http://localhost:5001

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173

# Email Configuration (choose one: Resend or SMTP)
# Option 1: Resend (recommended - free tier: 3000 emails/month)
# Get your API key at: https://resend.com
RESEND_API_KEY=

# Option 2: SMTP (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# From address for emails
EMAIL_FROM=noreply@balkanestate.com

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Sentry (Error Monitoring - optional)
SENTRY_DSN=
