# =============================================================================
# Backend Environment Variables
# =============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/balkanestate

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for sensitive data)
ENCRYPTION_KEY=your-32-character-encryption-key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# Payment Providers
# =============================================================================
# Provider selection is automatic based on user's country:
# - Stripe: EU countries (Greece, Croatia, Bulgaria, Romania, Slovenia) - ~2.9% fees
# - Paddle: Non-EU Balkans (Serbia, Albania, Bosnia, N. Macedonia, Montenegro, Kosovo) - ~5% fees

# Stripe (Payments - EU Countries)
# Get credentials from: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products/prices in Stripe dashboard)
STRIPE_PRICE_BUYER_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...

# Paddle (Payments - Non-EU Balkans)
# Paddle is a Merchant of Record (MoR) handling VAT/tax compliance globally
# Get credentials from: https://vendors.paddle.com/
PADDLE_API_KEY=your-paddle-api-key
PADDLE_CLIENT_TOKEN=your-paddle-client-token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs (create products/prices in Paddle dashboard)
PADDLE_PRICE_BUYER_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_YEARLY=pri_...
PADDLE_PRICE_AGENCY_MONTHLY=pri_...
PADDLE_PRICE_AGENCY_YEARLY=pri_...

# Backend URL (for webhooks)
BACKEND_URL=http://localhost:5001

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@balkanestate.com

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Sentry (Error Monitoring - optional)
SENTRY_DSN=
