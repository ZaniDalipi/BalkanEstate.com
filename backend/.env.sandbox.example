# ============================================================
# Sandbox environment — dummy values only, safe on any machine
# ============================================================
# Run `npm run setup:sandbox` (in backend/) to turn this into .env.development.
# It fills every __GENERATE__ with a fresh random value made on your machine,
# so no real secret ever has to leave Railway.
#
# Rules for this file:
#  - Never put a real key here. Production values live only in Railway.
#  - Every secret the backend reads is listed, even when empty: a key set here
#    (also to empty) hides the same key in an old backend/.env, so a real value
#    there can't leak into a sandbox run.
#  - Empty third-party keys switch that feature off; the server still starts.

NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# ── Database ─────────────────────────────────────────────────────────────────
# Empty = mongodb://localhost:27017, or an in-memory database if none runs
# there (data resets on restart). Point it at a local or throwaway database
# only, never the production cluster.
MONGODB_URI=
MONGO_URI=
REDIS_URL=

# ── Made on your machine (random per sandbox) ────────────────────────────────
JWT_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
ENCRYPTION_KEY=__GENERATE__
FIELD_ENCRYPTION_KEY=__GENERATE__
PASSWORD_PEPPER=__GENERATE__
FINGERPRINT_SECRET=__GENERATE__
SEARCH_HASH_SALT=__GENERATE__
AUDIT_SECRET=__GENERATE__
VAPID_PUBLIC_KEY=__GENERATE__
VAPID_PRIVATE_KEY=__GENERATE__
VAPID_SUBJECT=mailto:sandbox@example.com

# ── Third-party services: empty = feature off ────────────────────────────────
# To try one locally, use that service's test or sandbox mode, never a live key.

# Payments (Stripe test keys start with sk_test_ / whsec_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=

# Email: with neither set, emails are logged instead of sent
RESEND_API_KEY=
SMTP_USER=
SMTP_PASS=

# Media storage (Cloudflare R2): empty = uploads disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=

# Sign-in with Google / Apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY_PATH=

# In-app purchases
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Other data sources
OWM_API_KEY=
FIRMS_MAP_KEY=
UNSPLASH_ACCESS_KEY=

# Error tracking
SENTRY_DSN=

# Dev admin seeding (`npm run seed:dev-admin`): pass these on the command line
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
