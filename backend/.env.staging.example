# =============================================================================
# Backend Environment Variables - STAGING
# =============================================================================

# Server Configuration
PORT=5001
NODE_ENV=staging

# Database - STAGING MongoDB
# Replace with your staging MongoDB connection string
MONGODB_URI=mongodb+srv://your-staging-user:your-staging-password@staging-cluster.mongodb.net/balkanestate-staging?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-staging-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-staging-refresh-secret-key-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for sensitive data) - Must be 32 characters
ENCRYPTION_KEY=staging-32-char-encryption-key!

# CORS Configuration - Add your staging frontend URL
# Include localhost for local testing with staging backend
ALLOWED_ORIGINS=https://staging.balkanestate.com,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe (Payments - EU Countries: Greece, Croatia, Bulgaria, Romania, Slovenia)
# Use TEST keys for staging
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Paddle (Payments - Non-EU Balkans: Serbia, Albania, Bosnia, N. Macedonia, Montenegro, Kosovo)
# Use SANDBOX mode for staging
PADDLE_API_KEY=your-paddle-api-key
PADDLE_CLIENT_TOKEN=your-paddle-client-token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs (Sandbox prices for staging)
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_YEARLY=pri_...
PADDLE_PRICE_AGENCY_MONTHLY=pri_...
PADDLE_PRICE_AGENCY_YEARLY=pri_...

# Backend URL (for webhooks)
BACKEND_URL=https://api-staging.balkanestate.com

# Frontend URL (for redirects)
FRONTEND_URL=https://staging.balkanestate.com

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@balkanestate.com

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Sentry (Error Monitoring)
SENTRY_DSN=
