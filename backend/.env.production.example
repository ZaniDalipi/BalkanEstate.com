# =============================================================================
# Backend Environment Variables - PRODUCTION
# =============================================================================

# Server Configuration
PORT=5001
NODE_ENV=production

# Database - PRODUCTION MongoDB
# Replace with your production MongoDB connection string
MONGODB_URI=mongodb+srv://your-prod-user:your-prod-password@production-cluster.mongodb.net/balkanestate?retryWrites=true&w=majority

# Authentication - Use strong, unique secrets in production!
JWT_SECRET=your-production-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-production-refresh-secret-key-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for sensitive data) - Must be 32 characters, keep secure!
ENCRYPTION_KEY=prod-32-character-encryption-key

# CORS Configuration - Production frontend URL only
ALLOWED_ORIGINS=https://balkanestateai.com,https://www.balkanestateai.com

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe (Payments - EU Countries: Greece, Croatia, Bulgaria, Romania, Slovenia)
# Use LIVE keys for production
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Paddle (Payments - Non-EU Balkans: Serbia, Albania, Bosnia, N. Macedonia, Montenegro, Kosovo)
# Use PRODUCTION mode
PADDLE_API_KEY=your-paddle-live-api-key
PADDLE_CLIENT_TOKEN=your-paddle-live-client-token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENVIRONMENT=production

# Paddle Price IDs (Production prices)
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_YEARLY=pri_...
PADDLE_PRICE_AGENCY_MONTHLY=pri_...
PADDLE_PRICE_AGENCY_YEARLY=pri_...

# Backend URL (for webhooks)
BACKEND_URL=https://api.balkanestateai.com

# Frontend URL (for redirects)
FRONTEND_URL=https://balkanestateai.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=balkanestateai@gmail.com
SMTP_PASS=
EMAIL_FROM=balkanestateai@gmail.com

# Contact Info
CONTACT_PHONE=+389 71 967 915
CONTACT_EMAIL=balkanestateai@gmail.com

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Rate Limiting - More strict in production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sentry (Error Monitoring)
SENTRY_DSN=
