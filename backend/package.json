{
  "name": "balkan-estate-backend",
  "version": "1.0.0",
  "description": "Backend API for Balkan Estate real estate application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon --exec ts-node src/server.ts",
    "dev:staging": "NODE_ENV=staging nodemon --exec ts-node src/server.ts",
    "dev:prod": "NODE_ENV=production nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/server.js",
    "start:dev": "NODE_ENV=development node dist/server.js",
    "start:staging": "NODE_ENV=staging node dist/server.js",
    "setup:db": "NODE_ENV=development ts-node src/scripts/setupDatabase.ts",
    "setup:db:staging": "NODE_ENV=staging ts-node src/scripts/setupDatabase.ts",
    "setup:db:production": "NODE_ENV=production ts-node src/scripts/setupDatabase.ts",
    "seed:all": "npm run seed:products && npm run seed:cities && npm run seed:coupons",
    "seed:all:staging": "NODE_ENV=staging npm run seed:products && NODE_ENV=staging npm run seed:cities",
    "seed:all:production": "NODE_ENV=production npm run seed:products && NODE_ENV=production npm run seed:cities",
    "seed:products": "ts-node src/scripts/seedProducts.ts",
    "seed:products:staging": "NODE_ENV=staging ts-node src/scripts/seedProducts.ts",
    "seed:products:production": "NODE_ENV=production ts-node src/scripts/seedProducts.ts",
    "seed:agencies": "ts-node src/scripts/seedAgencies.ts",
    "seed:properties": "ts-node src/scripts/seedMockProperties.ts",
    "seed:cities": "ts-node scripts/seedCityData.ts",
    "seed:cities:staging": "NODE_ENV=staging ts-node scripts/seedCityData.ts",
    "seed:cities:production": "NODE_ENV=production ts-node scripts/seedCityData.ts",
    "test:agencies": "ts-node src/scripts/testAgencyAccess.ts",
    "test:find-agency": "ts-node src/scripts/testFindAgencyByCode.ts",
    "sync:agents": "ts-node src/scripts/syncAgents.ts",
    "cleanup:sold": "ts-node src/scripts/archiveSoldProperties.ts",
    "cleanup:conversations": "ts-node src/scripts/cleanupConversations.ts",
    "remove:agents": "ts-node src/scripts/removeAllAgents.ts",
    "migrate:agency-owners": "ts-node src/scripts/addOwnersToAgencyMembers.ts",
    "migrate:property-roles": "ts-node src/scripts/migratePropertyRoles.ts",
    "migrate:subscriptions": "ts-node src/scripts/migrateToNewSubscriptionSystem.ts",
    "rollback:subscriptions": "ts-node src/scripts/migrateToNewSubscriptionSystem.ts rollback",
    "init:stats": "ts-node src/scripts/initializeAllUserStats.ts",
    "sync:stats": "ts-node src/scripts/syncAllSellerStats.ts",
    "set-admin": "ts-node src/scripts/setAdminRole.ts",
    "seed:dev-admin": "ts-node src/scripts/seedDevAdmin.ts",
    "seed:dev": "npm run seed:products && npm run seed:dev-admin",
    "seed:coupons": "ts-node src/scripts/seedPromotionCoupons.ts",
    "test:engagement": "ts-node src/scripts/testEngagementNotifications.ts",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:payments": "jest --testPathPattern=payment --detectOpenHandles --forceExit",
    "test:payments:unit": "jest --testPathPattern=payment-services --detectOpenHandles --forceExit",
    "test:payments:integration": "jest --testPathPattern=payment-integration --detectOpenHandles --forceExit",
    "test:payments:api": "./test-payments.sh",
    "test:staging": "./scripts/test-staging-payments.sh"
  },
  "keywords": [
    "real-estate",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.32.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.0",
    "googleapis": "^144.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "resend": "^6.6.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "stripe": "^19.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/sharp": "^0.31.1",
    "@types/socket.io": "^3.0.1",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
