# Frontend build-time configuration (Vite). Copy to `.env` for local work;
# production values are supplied by .github/workflows/deploy.yml.
#
# Only VITE_-prefixed vars reach the browser bundle. Never put a secret here.

VITE_API_URL=http://localhost:5001/api

# ── Maps ─────────────────────────────────────────────────────────────────────
# CARTO and Stadia watermark keyless tiles with "API KEY REQUIRED". Set a key
# to use their styles; leave both blank to use a keyless provider instead.
VITE_CARTO_API_KEY=
VITE_STADIA_API_KEY=

# Which keyless basemap stands in when no key is set (see config/mapStyles.ts):
#   osm  — OpenStreetMap standard (default)
#   esri — Esri light/dark grey canvas, closer to the CARTO look
VITE_MAP_KEYLESS_PROVIDER=osm

# Optional: Google Maps JS API key. Without it the app uses Leaflet everywhere.
VITE_GOOGLE_MAPS_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
VITE_GA_ID=
VITE_FB_PIXEL_ID=
VITE_CLARITY_PROJECT_ID=

# ── AdSense fill for unbooked ad slots (optional) ───────────────────────────
# Every ad placement (src/features/promo) shows a directly sold banner when
# the admin has booked one for that slot. When a slot is empty, it fills from
# AdSense instead — but only once a real ad-unit slot id is set below; with
# none, the empty slot falls through to the "Your Ad Here" placeholder.
#
# Get slot ids from adsense.google.com → Ads → By ad unit → (create one per
# size) → the numeric "Ad unit ID" for each. Client defaults to this site's
# publisher id in code (see NetworkFill.tsx), so it rarely needs setting here.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_STICKY=
