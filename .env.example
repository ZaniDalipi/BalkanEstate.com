# =============================================================================
# Frontend Environment Variables Template
# Copy this file to .env.development, .env.staging, or .env.production
# =============================================================================

# Environment identifier (development | staging | production)
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=http://localhost:5001
VITE_WS_URL=ws://localhost:5001

# Frontend URL (for OAuth callbacks, etc.)
VITE_APP_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEVTOOLS=true

# Analytics
VITE_GA_ID=
VITE_FB_PIXEL_ID=

# =============================================================================
# Payment Configuration
# =============================================================================
# Payment provider is automatically selected based on user's country:
# - Stripe: EU countries (Greece, Croatia, Bulgaria, Romania, Slovenia)
# - Paddle: Non-EU Balkans (Serbia, Albania, Bosnia, N. Macedonia, Montenegro, Kosovo)

# Stripe - Get from https://dashboard.stripe.com/
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# Note: Paddle client token is fetched from backend API (/api/payments/paddle/config)
# No frontend Paddle config needed - it's loaded dynamically from the server

# AI Services
GEMINI_API_KEY=your_api_key

# Sentry
VITE_SENTRY_DSN=
