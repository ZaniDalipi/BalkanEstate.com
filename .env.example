# Frontend build-time configuration (Vite). Copy to `.env` for local work;
# production values are supplied by .github/workflows/deploy.yml.
#
# Only VITE_-prefixed vars reach the browser bundle. Never put a secret here.

VITE_API_URL=http://localhost:5001/api

# ── Images ───────────────────────────────────────────────────────────────────
# CDN hostname images are served from, without scheme — the Bunny pull zone.
# Must match BUNNY_PULL_ZONE_HOST in the backend, or every image 404s.
# e.g. balkanestate.b-cdn.net
VITE_CDN_HOST=

# ── Maps ─────────────────────────────────────────────────────────────────────
# CARTO and Stadia watermark keyless tiles with "API KEY REQUIRED". Set a key
# to use their styles; leave both blank to use a keyless provider instead.
VITE_CARTO_API_KEY=
VITE_STADIA_API_KEY=

# Which keyless basemap stands in when no key is set (see config/mapStyles.ts):
#   osm  — OpenStreetMap standard (default)
#   esri — Esri light/dark grey canvas, closer to the CARTO look
VITE_MAP_KEYLESS_PROVIDER=osm

# Optional: Google Maps JS API key. Without it the app uses Leaflet everywhere.
VITE_GOOGLE_MAPS_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
VITE_GA_ID=
VITE_FB_PIXEL_ID=
VITE_CLARITY_PROJECT_ID=
