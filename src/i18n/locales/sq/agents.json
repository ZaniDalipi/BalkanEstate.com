      "findAgent": {
        "question": "Si të gjej një agjent të mirë imobiliar afër meje?",
        "answer": "Filloni duke kërkuar agjentë në zonën tuaj duke përdorur kërkimin sipas vendndodhjes. Kërkoni agjentë me vlerësime të larta, rekorde të forta shitjesh dhe dëshmi nga klientët e fundit."
      },
      "pickAgent": {
        "question": "Si të zgjedh një agjent imobiliar?",
        "answer": "Merrni parasysh përvojën e tyre, njohurinë e tregut lokal, rekordin e shitjeve, vlerësimet e klientëve dhe stilin e komunikimit. Planifikoni konsultime me disa agjentë para se të merrni vendimin."
      },
      "contactAgent": {
        "question": "Si të kontaktoj një agjent imobiliar?",
        "answer": "Mund të shikoni profilin e agjentit për të gjetur informacionin e kontaktit, përfshirë numrin e telefonit dhe emailin. Shumë agjentë ofrojnë gjithashtu rezervim online të përshtatshëm për konsultime."
      },
      "leaveReview": {
        "question": "Si mund të lë një vlerësim për një agjent imobiliar?",
        "answer": "Vizitoni faqen e profilit të agjentit dhe klikoni butonin \"Shkruaj një Vlerësim\". Ndani përvojën tuaj për të ndihmuar të tjerët të marrin vendime të informuara."
      },
      "agentVsBroker": {
        "question": "Cila është ndryshimi midis një agjenti dhe një ndërmjetësi?",
        "answer": "Një agjent imobiliar është i licencuar për të ndihmuar klientët të blejnë dhe shesin pronë, ndërsa një ndërmjetës ka trajnim dhe certifikim shtesë. Ndërmjetësit mund të punojnë në mënyrë të pavarur dhe të menaxhojnë agjencitë e tyre."
      }
    }
  },
